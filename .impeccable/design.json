  "components": [
    {
      "name": "主要按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "暖金胶囊形的主要操作；源码此变体没有额外 hover 改色。",
      "html": "<button class=\"ds-primary\" type=\"button\">播放收藏</button>",
      "css": ".ds-primary{font:650 14px/1.5 \"Segoe UI\",\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;min-height:34px;padding:7px 14px;border:0;border-radius:var(--control-radius,999px);color:var(--accent-ink,#231b08);background:radial-gradient(ellipse at 30% 0%,#fff5,var(--accent,#f5c84c));box-shadow:0 5px 16px #f5c84c40;cursor:pointer;white-space:nowrap}.ds-primary:disabled{opacity:.42;cursor:not-allowed}.ds-primary:focus-visible{outline:2px solid var(--blue,#88c4ff);outline-offset:3px}@media(max-width:600px){.ds-primary{min-height:44px}}"
    },
    {
      "name": "次级按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "柔蓝表面承载辅助操作。",
      "html": "<button class=\"ds-secondary\" type=\"button\">取消</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;font:12px/1.5 \"Segoe UI\",\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;min-height:34px;padding:6px 10px;border:1px solid var(--border-strong,rgba(166,190,255,.26));border-radius:999px;color:var(--text-secondary,#c0cbe7);background:var(--surface-soft,rgba(136,196,255,.07));cursor:pointer}.ds-secondary:hover{color:#fff;background:var(--surface-active,rgba(136,196,255,.19))}.ds-secondary:focus-visible{outline:2px solid var(--blue,#88c4ff);outline-offset:3px}@media(max-width:600px){.ds-secondary{min-height:44px}}"
    },
    {
      "name": "搜索字段",
      "kind": "input",
      "refersTo": "search-input",
      "description": "胶囊搜索框、蓝色焦点与金色操作；手机字段和按钮38px，容器整体48px。",
      "html": "<div class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 4.5 4.5\"/></svg><input class=\"ds-input\" type=\"search\" aria-label=\"搜索歌曲或歌手\" placeholder=\"输入歌名、歌手…\"><button type=\"button\">搜索</button></div>",
      "css": ".ds-search{position:relative;display:flex;align-items:center;gap:6px;padding:4px;border:1px solid var(--border-strong,rgba(166,190,255,.26));border-radius:999px;background:linear-gradient(90deg,#88c4ff13,var(--bg-deep,#070a1e));box-shadow:0 3px 13px #88c4ff14}.ds-search:focus-within{border-color:var(--blue,#88c4ff);box-shadow:0 0 0 3px #88c4ff1c}.ds-search svg{position:absolute;left:11px;width:15px;height:15px;fill:none;stroke:var(--blue,#88c4ff);stroke-width:1.7}.ds-input{min-width:0;width:100%;height:34px;padding:0 2px 0 28px;border:0;outline:none;background:transparent;color:var(--text-primary,#f5f6ff);font:12px/1.5 \"Segoe UI\",\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;caret-color:var(--accent,#f5c84c)}.ds-input::placeholder{color:var(--text-muted,#a4b2d2);opacity:1}.ds-search button{flex-shrink:0;min-height:34px;padding:7px 14px;border:0;border-radius:999px;background:radial-gradient(ellipse at 30% 0%,#fff5,var(--accent,#f5c84c));color:var(--accent-ink,#231b08);box-shadow:0 5px 16px #f5c84c40;font:650 12px/1.5 \"Segoe UI\",\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;cursor:pointer}.ds-search button:focus-visible{outline:2px solid var(--blue,#88c4ff);outline-offset:3px}@media(max-width:600px){.ds-input{height:38px;font-size:16px}.ds-search button{min-height:38px}}"
    },
    {
