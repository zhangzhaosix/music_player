      "css": ".ds-tabs{display:flex;gap:2px;padding:4px;border:1px solid var(--border,rgba(166,190,255,.13));border-radius:999px;background:#0004}.ds-tab{flex:1;min-width:0;min-height:30px;padding:6px 3px;border:0;border-radius:999px;background:transparent;color:var(--text-muted,#a4b2d2);font:11px/1.5 \"Segoe UI\",\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif;white-space:nowrap;cursor:pointer}.ds-tab:hover{color:var(--text-primary,#f5f6ff)}.ds-tab[aria-current=page]{color:#d9edff;background:linear-gradient(120deg,#88c4ff4d,#88c4ff25);box-shadow:0 2px 12px #88c4ff33}.ds-tab:focus-visible{outline:2px solid var(--blue,#88c4ff);outline-offset:3px}@media(max-width:600px){.ds-tab{min-height:44px;font-size:12px}}"
